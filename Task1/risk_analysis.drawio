        <mxCell id="vptr8PX1cL78Xx3dD0ji-53" value="Исходный код, архитектурные и инфраструктурные схемы" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="353" y="1349" width="120" height="60" as="geometry" />
